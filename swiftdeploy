# Config
# ══════════════════════════════════════════════════════

MANIFEST = "manifest.yaml"
NGINX_CONF = "nginx.conf"
COMPOSE_FILE = "docker-compose.yml"
TEMPLATES_DIR = "templates"
POLICIES_DIR = "policies"
HISTORY_FILE = "history.jsonl"
AUDIT_FILE = "audit_report.md"
OPA_URL = "http://localhost:8181"


# ══════════════════════════════════════════════════════
# Manifest reader
# ══════════════════════════════════════════════════════

def load_manifest():
    if not os.path.exists(MANIFEST):
        log_fail("manifest.yaml not found")
        sys.exit(1)
    with open(MANIFEST, "r") as f:
        try:
            data = yaml.safe_load(f)
        except yaml.YAMLError as e:
            log_fail(f"manifest.yaml is not valid YAML: {e}")
            sys.exit(1)
    return data


def get_val(manifest, dotted_key, default=None):
    keys = dotted_key.split(".")
    val = manifest
    for k in keys:
        if isinstance(val, dict) and k in val:
            val = val[k]
        else:
            return default
    return val if val is not None else default


# ══════════════════════════════════════════════════════
# Template renderer
# ══════════════════════════════════════════════════════

def render_template(template_path, output_path, manifest):
    replacements = {
        "services_image": str(get_val(manifest, "services.image", "")),
        "services_port": str(get_val(manifest, "services.port", "3000")),
        "services_mode": str(get_val(manifest, "services.mode", "stable")),
        "services_version": str(get_val(manifest, "services.version", "1.0.0")),
        "restart_policy": str(get_val(manifest, "services.restart_policy", "unless-stopped")),
        "nginx_image": str(get_val(manifest, "nginx.image", "nginx:latest")),
        "nginx_port": str(get_val(manifest, "nginx.port", "8080")),
        "proxy_timeout": str(get_val(manifest, "nginx.proxy_timeout", "30")),
        "network_name": str(get_val(manifest, "network.name", "swiftdeploy-net")),
        "network_driver": str(get_val(manifest, "network.driver_type", "bridge")),
    }
    with open(template_path, "r") as f:
        content = f.read()
    for key, value in replacements.items():
        content = content.replace("{{" + key + "}}", value)
        content = content.replace("{{ " + key + " }}", value)
    with open(output_path, "w") as f:
        f.write(content)


# ══════════════════════════════════════════════════════
# Shell helpers
# ══════════════════════════════════════════════════════

def run_cmd(cmd, capture=False, check=True):
    if capture:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if check and result.returncode != 0:
            return None
        return result
    else:
        result = subprocess.run(cmd, shell=True)
        if check and result.returncode != 0:
            sys.exit(result.returncode)
        return result


def is_port_in_use(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(("127.0.0.1", int(port))) == 0


# ══════════════════════════════════════════════════════
# OPA Policy Engine
# ══════════════════════════════════════════════════════

def query_opa(policy_path, input_data, timeout=5):
    """Query OPA and return the decision. Returns None on failure."""
    import urllib.request
    import urllib.error

    url = f"{OPA_URL}/v1/data/{policy_path}"
    payload = json.dumps({"input": input_data}).encode("utf-8")

    req = urllib.request.Request(url, data=payload, method="POST")
    req.add_header("Content-Type", "application/json")

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = json.loads(resp.read().decode("utf-8"))
            return body.get("result", {})
    except urllib.error.URLError as e:
        log_warn(f"OPA unreachable: {e.reason}")
        return None
    except socket.timeout:
        log_warn("OPA request timed out")
        return None
    except json.JSONDecodeError:
        log_warn("OPA returned invalid JSON")
        return None
    except Exception as e:
        log_warn(f"OPA query failed: {e}")
        return None


def get_host_stats():
    """Gather host disk, CPU, and memory stats."""
    stats = {
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z",
    }

    # Disk free
    try:
        usage = shutil.disk_usage("/")
        stats["disk_free_gb"] = round(usage.free / (1024 ** 3), 2)
        stats["disk_total_gb"] = round(usage.total / (1024 ** 3), 2)
    except Exception:
        stats["disk_free_gb"] = 999.0
        stats["disk_total_gb"] = 999.0

    # CPU load (1 min average)
    try:
        with open("/proc/loadavg", "r") as f:
            stats["cpu_load"] = float(f.read().split()[0])
    except Exception:
        stats["cpu_load"] = 0.0

    # Memory
    try:
        with open("/proc/meminfo", "r") as f:
            meminfo = {}
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    key = parts[0].strip()
                    val = parts[1].strip().split()[0]
                    meminfo[key] = int(val)
            total = meminfo.get("MemTotal", 0)
            avail = meminfo.get("MemAvailable", 0)
            stats["mem_used_pct"] = round((total - avail) / total * 100, 1) if total > 0 else 0.0
    except Exception:
        stats["mem_used_pct"] = 0.0

    return stats


def check_pre_deploy_policy():
    """Run infrastructure policy check before deploy."""
    log_step("Running pre-deploy policy checks...")

    stats = get_host_stats()
    log_info(f"Host stats: disk_free={stats['disk_free_gb']}GB, cpu_load={stats['cpu_load']}, mem_used={stats['mem_used_pct']}%")

    result = query_opa("swiftdeploy/infra/result", stats)

    if result is None:
        log_warn("OPA is unavailable — skipping policy check (fail-open)")
        append_history({"event": "policy_check", "type": "pre-deploy", "status": "skipped", "reason": "OPA unavailable", "timestamp": stats["timestamp"]})
        return True

    allowed = result.get("allow", False)
    violations = result.get("violations", [])
    context = result.get("context", "")

    if allowed:
        log_ok(f"Pre-deploy policy passed ({context})")
        append_history({"event": "policy_check", "type": "pre-deploy", "status": "passed", "timestamp": stats["timestamp"]})
        return True
    else:
        log_policy(f"Pre-deploy policy DENIED ({context})")
        for v in violations:
            log_fail(f"  → {v}")
        append_history({"event": "policy_check", "type": "pre-deploy", "status": "denied", "violations": violations, "timestamp": stats["timestamp"]})
        return False


def scrape_metrics(port):
    """Scrape /metrics and parse Prometheus text format."""
    result = run_cmd(f"curl -sf http://localhost:{port}/metrics", capture=True, check=False)
    if not result or not result.stdout:
        return None

    data = {
        "requests": {},
        "durations": {},
        "uptime": 0,
        "mode": 0,
        "chaos": 0,
    }

    for line in result.stdout.splitlines():
        if line.startswith("#") or not line.strip():
            continue

        if line.startswith("http_requests_total{"):
            match = re.match(r'http_requests_total\{(.+)\}\s+(\d+)', line)
            if match:
                labels = match.group(1)
                count = int(match.group(2))
                data["requests"][labels] = count

        elif line.startswith("http_request_duration_seconds_sum{"):
            match = re.match(r'http_request_duration_seconds_sum\{(.+)\}\s+([\d.]+)', line)
            if match:
                labels = match.group(1)
                val = float(match.group(2))
                if labels not in data["durations"]:
                    data["durations"][labels] = {}
                data["durations"][labels]["sum"] = val

        elif line.startswith("http_request_duration_seconds_count{"):
            match = re.match(r'http_request_duration_seconds_count\{(.+)\}\s+(\d+)', line)
            if match:
                labels = match.group(1)
                val = int(match.group(2))
                if labels not in data["durations"]:
                    data["durations"][labels] = {}
                data["durations"][labels]["count"] = val

        elif line.startswith("http_request_duration_seconds_bucket{"):
            match = re.match(r'http_request_duration_seconds_bucket\{(.+),le="([^"]+)"\}\s+(\d+)', line)
            if match:
                labels = match.group(1)
                le = match.group(2)
                val = int(match.group(3))
                if labels not in data["durations"]:
                    data["durations"][labels] = {}
                if "buckets" not in data["durations"][labels]:
                    data["durations"][labels]["buckets"] = {}
                data["durations"][labels]["buckets"][le] = val

        elif line.startswith("app_uptime_seconds"):
            parts = line.split()
            if len(parts) >= 2:
                data["uptime"] = float(parts[1])

        elif line.startswith("app_mode "):
            parts = line.split()
            if len(parts) >= 2:
                data["mode"] = int(float(parts[1]))

        elif line.startswith("chaos_active "):
            parts = line.split()
            if len(parts) >= 2:
                data["chaos"] = int(float(parts[1]))

    return data


def calculate_metrics_summary(metrics_data):
    """Calculate error rate and P99 latency from scraped metrics."""
    total_requests = 0
    error_requests = 0

    for labels, count in metrics_data.get("requests", {}).items():
        total_requests += count
        if "status_code=5" in labels:
            error_requests += count

    error_rate = (error_requests / total_requests * 100) if total_requests > 0 else 0.0

    # Estimate P99 from histogram buckets
    p99_ms = 0.0
    for labels, dur_data in metrics_data.get("durations", {}).items():
        total = dur_data.get("count", 0)
        if total == 0:
            continue
        target = total * 0.99
        buckets = dur_data.get("buckets", {})
        sorted_buckets = sorted(
            [(float(le) if le != "+Inf" else float("inf"), v) for le, v in buckets.items()],
            key=lambda x: x[0]
        )
        for le, cumulative in sorted_buckets:
            if cumulative >= target:
                p99_ms = le * 1000
                break

    return {
        "total_requests": total_requests,
        "error_requests": error_requests,
        "error_rate_pct": round(error_rate, 2),
        "p99_latency_ms": round(p99_ms, 2),
    }


def check_pre_promote_policy(nginx_port):
    """Run canary safety policy check before promote."""
    log_step("Running pre-promote policy checks...")

    # Scrape metrics through nginx
    app_port = get_val(load_manifest(), "services.port", "3000")
    metrics_data = scrape_metrics(nginx_port)

    if metrics_data is None:
        log_warn("Could not scrape /metrics — skipping canary policy check")
        append_history({"event": "policy_check", "type": "pre-promote", "status": "skipped", "reason": "metrics unavailable", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})
        return True

    summary = calculate_metrics_summary(metrics_data)
    log_info(f"Metrics: total_reqs={summary['total_requests']}, errors={summary['error_requests']}, error_rate={summary['error_rate_pct']}%, p99={summary['p99_latency_ms']}ms")

    input_data = {
        "error_rate_pct": summary["error_rate_pct"],
        "p99_latency_ms": summary["p99_latency_ms"],
        "total_requests": summary["total_requests"],
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z",
    }

    result = query_opa("swiftdeploy/canary/result", input_data)

    if result is None:
        log_warn("OPA is unavailable — skipping canary policy check (fail-open)")
        append_history({"event": "policy_check", "type": "pre-promote", "status": "skipped", "reason": "OPA unavailable", "timestamp": input_data["timestamp"]})
        return True

    allowed = result.get("allow", False)
    violations = result.get("violations", [])
    context = result.get("context", "")

    if allowed:
        log_ok(f"Pre-promote policy passed ({context})")
        append_history({"event": "policy_check", "type": "pre-promote", "status": "passed", "metrics": summary, "timestamp": input_data["timestamp"]})
        return True
    else:
        log_policy(f"Pre-promote policy DENIED ({context})")
        for v in violations:
            log_fail(f"  → {v}")
        append_history({"event": "policy_check", "type": "pre-promote", "status": "denied", "violations": violations, "metrics": summary, "timestamp": input_data["timestamp"]})
        return False


# ══════════════════════════════════════════════════════
# History / Audit Trail
# ══════════════════════════════════════════════════════

def append_history(entry):
    """Append an entry to history.jsonl."""
    with open(HISTORY_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")


def load_history():
    """Load all entries from history.jsonl."""
    entries = []
    if not os.path.exists(HISTORY_FILE):
        return entries
    with open(HISTORY_FILE, "r") as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    entries.append(json.loads(line))
                except json.JSONDecodeError:
                    pass
    return entries


# ══════════════════════════════════════════════════════
# INIT
# ══════════════════════════════════════════════════════

def cmd_init():
    print(f"\n{BOLD}══ swiftdeploy init ══{NC}\n")

    manifest = load_manifest()

    log_step("Parsing manifest.yaml...")
    log_info(f"Image: {get_val(manifest, 'services.image')}")
    log_info(f"Mode:  {get_val(manifest, 'services.mode', 'stable')}")
    log_info(f"Port:  {get_val(manifest, 'nginx.port')}")

    nginx_tpl = os.path.join(TEMPLATES_DIR, "nginx.conf.tpl")
    if not os.path.exists(nginx_tpl):
        log_fail(f"Template not found: {nginx_tpl}")
        sys.exit(1)
    render_template(nginx_tpl, NGINX_CONF, manifest)
    log_ok(f"Generated {NGINX_CONF}")

    compose_tpl = os.path.join(TEMPLATES_DIR, "docker-compose.yml.tpl")
    if not os.path.exists(compose_tpl):
        log_fail(f"Template not found: {compose_tpl}")
        sys.exit(1)
    render_template(compose_tpl, COMPOSE_FILE, manifest)
    log_ok(f"Generated {COMPOSE_FILE}")

    # Ensure policies directory exists for OPA
    if not os.path.exists(POLICIES_DIR):
        log_warn(f"Policies directory '{POLICIES_DIR}' not found")
    else:
        rego_files = [f for f in os.listdir(POLICIES_DIR) if f.endswith(".rego")]
        log_ok(f"OPA will load {len(rego_files)} policy file(s) from {POLICIES_DIR}/")

    print()
    log_info("Init complete — configs generated from manifest")


# ══════════════════════════════════════════════════════
# VALIDATE
# ══════════════════════════════════════════════════════

def cmd_validate():
    print(f"\n{BOLD}══ swiftdeploy validate ══{NC}\n")

    failures = 0
    total = 5

    log_step("Check 1/5: manifest.yaml exists and is valid YAML")
    if os.path.exists(MANIFEST):
        try:
            with open(MANIFEST, "r") as f:
                yaml.safe_load(f)
            log_ok("manifest.yaml exists and is valid YAML")
        except yaml.YAMLError:
            log_fail("manifest.yaml is not valid YAML")
            failures += 1
    else:
        log_fail("manifest.yaml does not exist")
        failures += 1

    log_step("Check 2/5: Required fields are present")
    manifest = load_manifest()
    required = [
        "services.image", "services.port",
        "nginx.image", "nginx.port",
        "network.name", "network.driver_type",
    ]
    fields_ok = True
    for field in required:
        val = get_val(manifest, field)
        if val is None or str(val).strip() == "":
            log_fail(f"  Missing: {field}")
            fields_ok = False
            failures += 1
    if fields_ok:
        log_ok("All required fields are present and non-empty")

    log_step("Check 3/5: Docker image exists locally")
    image = get_val(manifest, "services.image")
    result = run_cmd(f"docker image inspect {image}", capture=True, check=False)
    if result and result.returncode == 0:
        log_ok(f"Docker image '{image}' exists locally")
    else:
        log_fail(f"Docker image '{image}' not found locally")
        failures += 1

    log_step("Check 4/5: Nginx port is available")
    nginx_port = get_val(manifest, "nginx.port")
    if is_port_in_use(nginx_port):
        log_fail(f"Port {nginx_port} is already in use")
        failures += 1
    else:
        log_ok(f"Port {nginx_port} is available")

    log_step("Check 5/5: nginx.conf syntax check")
    if os.path.exists(NGINX_CONF):
        abs_conf = os.path.abspath(NGINX_CONF)
        result = run_cmd(
            f'docker run --rm --add-host app:127.0.0.1 -v "{abs_conf}:/etc/nginx/conf.d/default.conf:ro" nginx:latest nginx -t',
            capture=True, check=False,
        )
        if result and result.returncode == 0:
            log_ok("nginx.conf is syntactically valid")
        else:
            log_fail("nginx.conf has syntax errors")
            failures += 1
    else:
        log_warn("nginx.conf not found — run './swiftdeploy init' first")
        log_fail("nginx.conf validation skipped")
        failures += 1

    print()
    print(f"{BOLD}────────────────────────────{NC}")
    passed = total - failures
    if failures == 0:
        print(f"{GREEN}{BOLD}Result: {passed}/{total} checks passed{NC}")
    else:
        print(f"{RED}{BOLD}Result: {passed}/{total} checks passed ({failures} failed){NC}")
        sys.exit(1)


# ══════════════════════════════════════════════════════
# DEPLOY (with OPA pre-deploy gate)
# ══════════════════════════════════════════════════════

def cmd_deploy():
    print(f"\n{BOLD}══ swiftdeploy deploy ══{NC}\n")

    manifest = load_manifest()

    # Build image if needed
    image = get_val(manifest, "services.image")
    result = run_cmd(f"docker image inspect {image}", capture=True, check=False)
    if result and result.returncode == 0:
        log_ok(f"Image already exists: {image}")
    else:
        log_step(f"Building Docker image: {image}")
        run_cmd(f"docker build -t {image} .")
        log_ok(f"Image built: {image}")

    # Run init
    cmd_init()

    # Start OPA first so we can query it
    log_step("Starting OPA for policy checks...")
    run_cmd(f"docker compose -f {COMPOSE_FILE} up -d opa", check=False)
    time.sleep(3)  # Give OPA time to load policies

    # Pre-deploy policy check
    if not check_pre_deploy_policy():
        log_fail("Deploy blocked by policy. Fix violations and retry.")
        append_history({"event": "deploy", "status": "blocked", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})
        sys.exit(1)

    # Start containers
    log_step("Starting containers...")
    run_cmd(f"docker compose -f {COMPOSE_FILE} up -d")
    log_ok("Containers started")

    append_history({"event": "deploy", "status": "started", "mode": get_val(manifest, "services.mode", "stable"), "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})

    # Wait for health
    nginx_port = get_val(manifest, "nginx.port")
    log_step("Waiting for health checks (timeout: 60s)...")

    elapsed = 0
    timeout = 60
    while elapsed < timeout:
        result = run_cmd(
            f"curl -sf http://localhost:{nginx_port}/healthz",
            capture=True, check=False,
        )
        if result and result.returncode == 0 and result.stdout.strip():
            print()
            log_ok("Health check passed!")
            print()
            log_info(f"Service is live at http://localhost:{nginx_port}")
            print()
            print(f"{BOLD}Health response:{NC}")
            try:
                health = json.loads(result.stdout)
                print(json.dumps(health, indent=2))
            except json.JSONDecodeError:
                print(result.stdout)
            print()
            append_history({"event": "deploy", "status": "healthy", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})
            return

        sys.stdout.write(".")
        sys.stdout.flush()
        time.sleep(2)
        elapsed += 2

    print()
    log_fail(f"Health check timed out after {timeout}s")
    run_cmd(f"docker compose -f {COMPOSE_FILE} logs --tail=20", check=False)
    sys.exit(1)


# ══════════════════════════════════════════════════════
# PROMOTE (with OPA pre-promote gate)
# ══════════════════════════════════════════════════════

def cmd_promote(target):
    if not target:
        log_fail("Usage: ./swiftdeploy promote [canary|stable]")
        sys.exit(1)

    if target not in ("canary", "stable"):
        log_fail(f"Invalid mode: '{target}'. Use 'canary' or 'stable'")
        sys.exit(1)

    print(f"\n{BOLD}══ swiftdeploy promote → {target} ══{NC}\n")

    manifest = load_manifest()
    nginx_port = get_val(manifest, "nginx.port")

    # Pre-promote policy check (only when promoting to stable from canary)
    if target == "stable" and get_val(manifest, "services.mode") == "canary":
        if not check_pre_promote_policy(nginx_port):
            log_fail("Promotion blocked by canary safety policy. Fix violations and retry.")
            append_history({"event": "promote", "target": target, "status": "blocked", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})
            sys.exit(1)

    # Update manifest
    log_step(f"Updating manifest.yaml → mode: {target}")
    with open(MANIFEST, "r") as f:
        content = f.read()

    content = re.sub(
        r"^(\s+mode:\s*).*$",
        rf"\g<1>{target}",
        content,
        flags=re.MULTILINE,
    )

    with open(MANIFEST, "w") as f:
        f.write(content)
    log_ok("manifest.yaml updated")

    # Regenerate docker-compose.yml
    log_step("Regenerating docker-compose.yml...")
    manifest = load_manifest()
    compose_tpl = os.path.join(TEMPLATES_DIR, "docker-compose.yml.tpl")
    render_template(compose_tpl, COMPOSE_FILE, manifest)
    log_ok(f"docker-compose.yml regenerated with MODE={target}")

    # Restart only the app container
    log_step("Restarting app container...")
    run_cmd(f"docker compose -f {COMPOSE_FILE} up -d --no-deps --force-recreate app")
    log_ok("App container restarted")

    append_history({"event": "promote", "target": target, "status": "completed", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})

    # Confirm new mode
    log_step("Confirming mode switch...")

    elapsed = 0
    while elapsed < 30:
        result = run_cmd(
            f"curl -sf http://localhost:{nginx_port}/healthz",
            capture=True, check=False,
        )
        if result and result.returncode == 0 and result.stdout.strip():
            print()
            log_ok(f"Promotion to '{target}' confirmed!")
            print()
            print(f"{BOLD}Health response:{NC}")
            try:
                health = json.loads(result.stdout)
                print(json.dumps(health, indent=2))
            except json.JSONDecodeError:
                print(result.stdout)
            print()

            if target == "canary":
                print(f"{BOLD}Response headers:{NC}")
                headers_result = run_cmd(
                    f"curl -sI http://localhost:{nginx_port}/healthz",
                    capture=True, check=False,
                )
                if headers_result and headers_result.stdout:
                    for line in headers_result.stdout.splitlines():
                        low = line.lower()
                        if "x-mode" in low or "x-deployed" in low:
                            print(f"  {line}")
                print()
            return

        sys.stdout.write(".")
        sys.stdout.flush()
        time.sleep(2)
        elapsed += 2

    print()
    log_fail("Failed to confirm mode switch within 30s")
    sys.exit(1)


