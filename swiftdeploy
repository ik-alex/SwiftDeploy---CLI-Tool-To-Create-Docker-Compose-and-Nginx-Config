# TEARDOWN
# ══════════════════════════════════════════════════════

def cmd_teardown(clean=False):
    print(f"\n{BOLD}══ swiftdeploy teardown ══{NC}\n")

    if os.path.exists(COMPOSE_FILE):
        log_step("Stopping and removing containers, networks, volumes...")
        run_cmd(
            f"docker compose -f {COMPOSE_FILE} down -v --remove-orphans",
            check=False,
        )
        log_ok("Stack removed")
    else:
        log_warn("No docker-compose.yml found — nothing to tear down")

    append_history({"event": "teardown", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"})

    if clean:
        log_step("Cleaning generated config files...")
        for f in [NGINX_CONF, COMPOSE_FILE, HISTORY_FILE, AUDIT_FILE]:
            if os.path.exists(f):
                os.remove(f)
        log_ok("Removed generated files")

    print()
    log_info("Teardown complete")


