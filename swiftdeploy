# AUDIT (generate report from history)
# ══════════════════════════════════════════════════════

def cmd_audit():
    print(f"\n{BOLD}══ swiftdeploy audit ══{NC}\n")

    entries = load_history()
    if not entries:
        log_warn("No history found. Run 'swiftdeploy status' or deploy first.")
        return

    log_step(f"Parsing {len(entries)} history entries...")

    report = []
    report.append("# SwiftDeploy Audit Report")
    report.append("")
    report.append(f"Generated: {datetime.datetime.now(datetime.timezone.utc).isoformat()}Z")
    report.append(f"Total events: {len(entries)}")
    report.append("")

    # Timeline
    report.append("## Timeline")
    report.append("")
    report.append("| Timestamp | Event | Details |")
    report.append("|-----------|-------|---------|")

    for e in entries:
        ts = e.get("timestamp", "?")
        event = e.get("event", "?")

        if event == "deploy":
            status = e.get("status", "?")
            mode = e.get("mode", "")
            details = f"Deploy {status}" + (f" (mode: {mode})" if mode else "")
            report.append(f"| {ts} | Deploy | {details} |")

        elif event == "promote":
            target = e.get("target", "?")
            status = e.get("status", "?")
            report.append(f"| {ts} | Promote | → {target} ({status}) |")

        elif event == "policy_check":
            ptype = e.get("type", "?")
            status = e.get("status", "?")
            report.append(f"| {ts} | Policy Check | {ptype}: {status} |")

        elif event == "teardown":
            report.append(f"| {ts} | Teardown | Stack removed |")

    report.append("")

    # Violations
    report.append("## Policy Violations")
    report.append("")

    violations_found = False
    for e in entries:
        if e.get("event") == "policy_check" and e.get("status") == "denied":
            violations_found = True
            ts = e.get("timestamp", "?")
            ptype = e.get("type", "?")
            report.append(f"### {ptype} — {ts}")
            report.append("")
            for v in e.get("violations", []):
                report.append(f"- {v}")
            report.append("")

    if not violations_found:
        report.append("No policy violations recorded.")
        report.append("")

    # Metrics summary from status scrapes
    scrapes = [e for e in entries if e.get("event") == "status_scrape"]
    if scrapes:
        report.append("## Metrics Summary")
        report.append("")
        report.append(f"Total scrapes: {len(scrapes)}")
        report.append("")

        error_rates = [s["metrics"]["error_rate_pct"] for s in scrapes if "metrics" in s]
        p99s = [s["metrics"]["p99_latency_ms"] for s in scrapes if "metrics" in s]

        if error_rates:
            report.append(f"- Error rate: min={min(error_rates)}%, max={max(error_rates)}%, avg={sum(error_rates)/len(error_rates):.2f}%")
        if p99s:
            report.append(f"- P99 latency: min={min(p99s)}ms, max={max(p99s)}ms, avg={sum(p99s)/len(p99s):.2f}ms")

        # Check for chaos events
        chaos_events = [s for s in scrapes if s.get("chaos", "none") != "none"]
        if chaos_events:
            report.append("")
            report.append("### Chaos Events Observed")
            report.append("")
            report.append("| Timestamp | Chaos Type | Error Rate | P99 Latency |")
            report.append("|-----------|-----------|------------|-------------|")
            for ce in chaos_events:
                ts = ce.get("timestamp", "?")
                chaos = ce.get("chaos", "?")
                er = ce.get("metrics", {}).get("error_rate_pct", "?")
                p99 = ce.get("metrics", {}).get("p99_latency_ms", "?")
                report.append(f"| {ts} | {chaos} | {er}% | {p99}ms |")

        report.append("")

    # Write file
    report_content = "\n".join(report)
    with open(AUDIT_FILE, "w") as f:
        f.write(report_content)

    log_ok(f"Audit report written to {AUDIT_FILE}")
    print()
    print(report_content)


