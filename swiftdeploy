# Main entry point
# ══════════════════════════════════════════════════════

def show_help():
    print(f"\n{BOLD}swiftdeploy{NC} — Declarative deployment CLI with OPA policy enforcement\n")
    print("Usage: ./swiftdeploy <command> [options]\n")
    print("Commands:")
    print("  init                Parse manifest → generate nginx.conf + docker-compose.yml")
    print("  validate            Run 5 pre-flight checks")
    print("  deploy              Init + policy check + start stack + wait for health")
    print("  promote <mode>      Switch to canary or stable (with policy gate)")
    print("  status              Live-refreshing terminal dashboard")
    print("  audit               Generate audit_report.md from history")
    print("  teardown [--clean]  Remove stack; --clean deletes generated configs")
    print("  help                Show this help message")
    print()
    print("Examples:")
    print("  ./swiftdeploy deploy")
    print("  ./swiftdeploy promote canary")
    print("  ./swiftdeploy status")
    print("  ./swiftdeploy audit")
    print("  ./swiftdeploy teardown --clean")


def main():
    args = sys.argv[1:]
    command = args[0] if args else "help"

    if command == "init":
        cmd_init()
    elif command == "validate":
        cmd_validate()
    elif command == "deploy":
        cmd_deploy()
    elif command == "promote":
        target = args[1] if len(args) > 1 else ""
        cmd_promote(target)
    elif command == "status":
        cmd_status()
    elif command == "audit":
        cmd_audit()
    elif command == "teardown":
        clean = "--clean" in args
        cmd_teardown(clean)
    elif command == "help":
        show_help()
    else:
        log_fail(f"Unknown command: '{command}'")
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
