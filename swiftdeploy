# STATUS (live dashboard)
# ══════════════════════════════════════════════════════

def cmd_status():
    print(f"\n{BOLD}══ swiftdeploy status ══{NC}")

    manifest = load_manifest()
    nginx_port = get_val(manifest, "nginx.port")

    try:
        while True:
            # Clear screen
            os.system("clear" if os.name != "nt" else "cls")
            now = datetime.datetime.now(datetime.timezone.utc).isoformat() + "Z"

            print(f"{BOLD}══ SwiftDeploy Status Dashboard ══{NC}")
            print(f"Time: {now}")
            print()

            # Scrape metrics
            metrics_data = scrape_metrics(nginx_port)

            if metrics_data is None:
                print(f"{RED}Could not scrape /metrics — is the stack running?{NC}")
                print(f"\nRefreshing in 3s... (Ctrl+C to exit)")
                time.sleep(3)
                continue

            summary = calculate_metrics_summary(metrics_data)

            # Display metrics
            mode_str = "canary" if metrics_data["mode"] == 1 else "stable"
            chaos_map = {0: "none", 1: "slow", 2: "error"}
            chaos_str = chaos_map.get(metrics_data["chaos"], "unknown")

            print(f"{BOLD}── Service ──{NC}")
            print(f"  Mode:          {CYAN}{mode_str}{NC}")
            print(f"  Uptime:        {metrics_data['uptime']:.1f}s")
            print(f"  Chaos:         {YELLOW if chaos_str != 'none' else GREEN}{chaos_str}{NC}")
            print()

            print(f"{BOLD}── Traffic ──{NC}")
            print(f"  Total Requests: {summary['total_requests']}")
            print(f"  Errors:         {summary['error_requests']}")
            error_color = RED if summary['error_rate_pct'] > 1 else GREEN
            print(f"  Error Rate:     {error_color}{summary['error_rate_pct']}%{NC}")
            p99_color = RED if summary['p99_latency_ms'] > 500 else GREEN
            print(f"  P99 Latency:    {p99_color}{summary['p99_latency_ms']}ms{NC}")
            print()

            # Policy compliance
            print(f"{BOLD}── Policy Compliance ──{NC}")

            host_stats = get_host_stats()
            infra_result = query_opa("swiftdeploy/infra/result", host_stats)
            if infra_result:
                infra_ok = infra_result.get("allow", False)
                status_icon = f"{GREEN}✓{NC}" if infra_ok else f"{RED}✗{NC}"
                print(f"  {status_icon} Infrastructure Policy")
                for v in infra_result.get("violations", []):
                    print(f"      {RED}→ {v}{NC}")
            else:
                print(f"  {YELLOW}? Infrastructure Policy (OPA unavailable){NC}")

            canary_input = {
                "error_rate_pct": summary["error_rate_pct"],
                "p99_latency_ms": summary["p99_latency_ms"],
                "total_requests": summary["total_requests"],
                "timestamp": now,
            }
            canary_result = query_opa("swiftdeploy/canary/result", canary_input)
            if canary_result:
                canary_ok = canary_result.get("allow", False)
                status_icon = f"{GREEN}✓{NC}" if canary_ok else f"{RED}✗{NC}"
                print(f"  {status_icon} Canary Safety Policy")
                for v in canary_result.get("violations", []):
                    print(f"      {RED}→ {v}{NC}")
            else:
                print(f"  {YELLOW}? Canary Safety Policy (OPA unavailable){NC}")

            print()
            print(f"Refreshing in 3s... (Ctrl+C to exit)")

            # Append to history
            history_entry = {
                "event": "status_scrape",
                "timestamp": now,
                "mode": mode_str,
                "chaos": chaos_str,
                "metrics": summary,
                "infra_policy": "pass" if (infra_result and infra_result.get("allow")) else "fail" if infra_result else "unknown",
                "canary_policy": "pass" if (canary_result and canary_result.get("allow")) else "fail" if canary_result else "unknown",
            }
            append_history(history_entry)

            time.sleep(3)

    except KeyboardInterrupt:
        print(f"\n{NC}Status dashboard stopped.")


